# Normalize line endings — kills phantom CRLF/LF diffs across machines.
# Git stores LF; checks out native on each OS. No effect on the live site.
* text=auto

# Force LF for web source + config so builds are byte-identical everywhere.
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf

# Treat these as binary — never touch their bytes.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
